---
import Container from "../container.astro";
import Intro from "../intro/index.astro";
---

<section class="cta-parksville">
    <Container customClass="cta-parksville__inner" width="narrow" smartSpacing>
        <Intro
            blockName="cta-parksville"
            marketingHeading="Take Your Web Production to the Next Level."
            lede="ChampCSS is going to help you to build professional websites that meet web standards fast. It’s absolutely free, so what are you waiting for? Go download your copy today."
            HasButtons
            buttonOneText="Grab Your Copy"
            buttonOneHref="/download"
            hasSecondBtn
            buttonTwoHref="/contact"
            buttonTwoText="Get in Touch"
            />
    </Container>
</section>